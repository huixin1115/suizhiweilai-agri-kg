// 农业农作物知识图谱 —— Neo4j 导入脚本
// 节点 669 个，关系 3440 条；关系类型 21 种
// 使用方式: cat neo4j_import.cypher | cypher-shell -u neo4j -p <password>

// ---------- 约束 ----------
CREATE CONSTRAINT `农作物_id` IF NOT EXISTS FOR (n:`农作物`) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT `作物类别_id` IF NOT EXISTS FOR (n:`作物类别`) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT `品种_id` IF NOT EXISTS FOR (n:`品种`) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT `病虫害_id` IF NOT EXISTS FOR (n:`病虫害`) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT `防治措施_id` IF NOT EXISTS FOR (n:`防治措施`) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT `肥料_id` IF NOT EXISTS FOR (n:`肥料`) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT `养分元素_id` IF NOT EXISTS FOR (n:`养分元素`) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT `土壤类型_id` IF NOT EXISTS FOR (n:`土壤类型`) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT `气候类型_id` IF NOT EXISTS FOR (n:`气候类型`) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT `产区_id` IF NOT EXISTS FOR (n:`产区`) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT `生育期_id` IF NOT EXISTS FOR (n:`生育期`) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT `农事操作_id` IF NOT EXISTS FOR (n:`农事操作`) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT `季节_id` IF NOT EXISTS FOR (n:`季节`) REQUIRE n.id IS UNIQUE;

